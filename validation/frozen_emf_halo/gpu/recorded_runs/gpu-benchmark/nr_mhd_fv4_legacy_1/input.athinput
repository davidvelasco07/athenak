<job>
basename = test

<mesh>
nghost = 10
nx1 = 256
x1min = -6
x1max = 6
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = -6
x2max = 6
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -6
x3max = 6
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.2
nlim = 32
tlim = 100
ndiag = 32

<coord>
special_rel = false
general_rel = false
minkowski = true

<mhd>
eos = ideal
reconstruct = fv4
rsolver = hlle
gamma = 1.6666666666666667
mood = true
mood_detect = true
mood_max_revs = 2
mood_nad_scale = rcfl
mood_rtol = 0.0001
mood_sed = true
dfloor = 1e-12
pfloor = 1e-12
mood_frozen_emf = false
emf = uct_hll
mood_edge = flag
mood_nad_bcc = avg
mood_touched_only = false
mood_nad_v = off

<problem>
inner_radius = 0.8
outer_radius = 1.0
pn_amb = 0.1
dn_amb = 1.0
pi_amb = 0.1
di_amb = 1.0
prat = 100
drat = 1
b_amb = 0.1
b_angle = 35

<output1>
file_type = log
dcycle = 1

<output2>
file_type = hst
dt = 100
data_format = %.17e

