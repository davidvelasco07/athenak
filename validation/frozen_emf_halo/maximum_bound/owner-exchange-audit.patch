+// TEST ONLY: dense owner-value exchange for a uniform periodic grid.
+// One MeshBlockPack per rank, CPU reference implementation; not scalable.
+#ifndef MHD_HALO_OWNER_AUDIT_HPP_
+#define MHD_HALO_OWNER_AUDIT_HPP_
+#include <vector>
+#include "mesh/mesh.hpp"
+#if MPI_PARALLEL_ENABLED
+#include <mpi.h>
+#endif
+namespace mhd {
+template<class View>
+void HaloOwnerAudit(MeshBlockPack *pack, const View &view) {
+  auto *mesh=pack->pmesh;
+  if (pack->nmb_thispack != mesh->nmb_thisrank || mesh->multilevel) {
+    std::cerr << "Owner audit requires one uniform pack per rank\n"; std::exit(1);
+  }
+  const auto &q=mesh->mb_indcs;
+  const int nx=mesh->mesh_indcs.nx1, ny=mesh->mesh_indcs.nx2;
+  const int nz=mesh->mesh_indcs.nx3;
+  const int nv=(View::rank==5)?view.extent_int(1):1;
+  const int ni=view.extent_int(View::rank-1);
+  const int nj=view.extent_int(View::rank-2);
+  const int nk=view.extent_int(View::rank-3);
+  auto h=Kokkos::create_mirror_view_and_copy(Kokkos::HostSpace(),view);
+  auto val=[&](int m,int v,int k,int j,int i)->Real& {
+    if constexpr (View::rank==5) return h(m,v,k,j,i);
+    else return h(m,k,j,i);
+  };
+  std::vector<Real> global(static_cast<size_t>(nx)*ny*nz*nv,0.0);
+  auto idx=[&](int v,int z,int y,int x) {
+    return ((static_cast<size_t>(v)*nz+z)*ny+y)*nx+x;
+  };
+  for (int m=0;m<pack->nmb_thispack;++m) {
+    auto l=mesh->lloc_eachmb[pack->pmb->mb_gid.h_view(m)];
+    for (int v=0;v<nv;++v) for (int k=q.ks;k<=q.ke;++k)
+    for (int j=q.js;j<=q.je;++j) for (int i=q.is;i<=q.ie;++i)
+      global[idx(v,l.lx3*q.nx3+k-q.ks,l.lx2*q.nx2+j-q.js,
+                   l.lx1*q.nx1+i-q.is)]=val(m,v,k,j,i);
+  }
+#if MPI_PARALLEL_ENABLED
+  MPI_Allreduce(MPI_IN_PLACE,global.data(),static_cast<int>(global.size()),
+                MPI_ATHENA_REAL,MPI_SUM,MPI_COMM_WORLD);
+#endif
+  auto wrap=[](int a,int n) {return (a%n+n)%n;};
+  for (int m=0;m<pack->nmb_thispack;++m) {
+    auto l=mesh->lloc_eachmb[pack->pmb->mb_gid.h_view(m)];
+    for (int v=0;v<nv;++v) for (int k=0;k<nk;++k)
+    for (int j=0;j<nj;++j) for (int i=0;i<ni;++i)
+      val(m,v,k,j,i)=global[idx(v,wrap(l.lx3*q.nx3+k-q.ks,nz),
+           wrap(l.lx2*q.nx2+j-q.js,ny),wrap(l.lx1*q.nx1+i-q.is,nx))];
+  }
+  Kokkos::deep_copy(view,h);
+}
+} // namespace mhd
+#endif
