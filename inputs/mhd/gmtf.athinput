# AthenaK input file for isothermal Bondi accretion

<comment>
problem   = gravo-magneto-turbulent fragmentation

<job>
basename  = GMTF       # problem ID: basename of output filenames

<mesh>
nghost    = 2         # Number of ghost cells
nx1       = 64       # Number of zones in X1-direction
x1min     = -2.0      # minimum value of X1
x1max     = 2.0       # maximum value of X1
ix1_bc    = periodic  # Inner-X1 boundary condition flag
ox1_bc    = periodic  # Outer-X1 boundary condition flag

nx2       = 64       # Number of zones in X2-direction
x2min     = -2.0      # minimum value of X2
x2max     = 2.0       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 64       # Number of zones in X3-direction
x3min     = -2.0      # minimum value of X3
x3max     = 2.0       # maximum value of X3
ix3_bc    = periodic  # Inner-X3 boundary condition flag
ox3_bc    = periodic  # Outer-X3 boundary condition flag

<meshblock>
nx1       = 32       # Number of cells in each MeshBlock, X1-dir
nx2       = 32       # Number of cells in each MeshBlock, X2-dir
nx3       = 32       # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk2       # time integration algorithm
cfl_number = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 1.0       # time limit
ndiag      = 1         # cycles between diagostic output

<mhd>
eos         = isothermal  # EOS type
reconstruct = plm    # spatial reconstruction method
rsolver     = hlle   # Riemann-solver to be used
iso_sound_speed = 1.0  # isothermal sound speed

<problem>
Mach       = 10       # 3D Mach number of initial turbulence
mu_phi     = 2
sfe_term   = 0.15     # Terminal SFE to stop the simulation.
rseed      = 0
nlow       = 0
nhigh      = 16
expo       = 2.0

<output1>
file_type   = hst      # Particle VTK data dump
dt          = 0.0001   # time increment between outputs

<output2>
file_type   = bin      # Particle VTK data dump
variable    = mhd_u
dt          = 0.001    # time increment between outputs

<output3>
file_type   = rst      # Particle VTK data dump
dt          = 999      # time increment between outputs
