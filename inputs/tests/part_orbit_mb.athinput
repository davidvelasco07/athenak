# AthenaK input: minimal sink-particle gravity-slice validation
# Two equal-mass sink particles orbiting their COM under multigrid self-gravity.
# Gas is uniform, negligible, and gravity-inert (hydro self_gravity=false) so the
# test isolates the particle path: deposit -> AssembleSource -> solve -> gather -> KDK.
# Free-fall variant: run with  problem/vorbit=0.0

<job>
basename = part_orbit

<mesh>
nghost = 4
nx1    = 64
x1min  = -0.5
x1max  =  0.5
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -0.5
x2max  =  0.5
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -0.5
x3max  =  0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
tlim       = 2.6
nlim       = -1
ndiag      = 200

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = llf
iso_sound_speed = 1.0

<gravity>
four_pi_G      = 1.0
# isolated boundaries via multipole expansion (domain BCs are non-periodic above)
mg_bc          = multipole
mporder        = 4
threshold      = -1
niteration     = 20
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
show_defect    = 0
mg_verbose     = 0
mg_nghost      = 1
root_on_host   = false

<hydro_srcterms>
self_gravity = false

<particles>
type   = sink
pusher = leapfrog
# ppc * nmb * ncells = particle count. 2 / 64^3 = 2^-17 (exact) -> exactly 2 particles.
ppc    = 7.62939453125e-06

<problem>
mass       = 1.0
separation = 0.3
rho0       = 1.0e-8
# vfrac multiplies the circular speed sqrt(G m / 2d): 1.0 = orbit, 0.0 = head-on free-fall.
vfrac      = 1.0
# rigid offset of the particle pair from the box centre (for placing it away from
# MeshBlock boundaries when decomposing the mesh, for testing)
offx       = 0.0
offy       = 0.0
offz       = 0.0
