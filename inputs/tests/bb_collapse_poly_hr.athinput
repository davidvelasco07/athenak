# Boss-Bodenheimer collapse, PIECEWISE-POLYTROPIC (barotropic) EOS -- Bleuler & Teyssier
# 2014 fig 8 analogue. Same uniform sphere + m=2 + rotation as the isothermal run, but the
# gas heats once dense (P = cs^2 rho below rho1; kap1 rho^1.1 up to rho2; kap2 rho^4/3 above),
# which slows the collapse -> two distinct pressure-supported fragments -> clean binary.
#
# Implemented as an IDEAL-gas solver (gamma=4/3) with a per-stage energy projection onto the
# barotropic curve (pgen user_srcs_func BBBarotropicReset). cs_iso = cold-branch sound speed.
# Same code units cs=1, 4piG=1; t_ff ~ 0.351.

<comment>
problem = Boss-Bodenheimer collapse, piecewise-polytropic EOS (fig 8)

<job>
basename = bb_collapse_poly_hr

<mesh>
nghost = 4
nx1    = 64
x1min  = -2.0
x1max  =  2.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -2.0
x2max  =  2.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -2.0
x3max  =  2.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement          = adaptive
max_nmb_per_rank    = 8192
num_levels          = 4
refinement_interval = 1

<amr_criterion0>
method = user

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.7        # ~1.99 t_ff (hi-res + barotropic support -> slower)
ndiag      = 100

<hydro>
eos             = ideal
gamma           = 1.3333333333333333
reconstruct     = plm
rsolver         = hllc
dfloor          = 1.0e-8
pfloor          = 1.0e-8

<gravity>
four_pi_G      = 1.0
mg_bc          = multipole
mporder        = 4
threshold      = -1
niteration     = 10
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
mg_nghost      = 1
root_on_host   = false

<hydro_srcterms>
self_gravity = true

<particles>
type        = sink
pusher      = leapfrog
accretion   = true
creation    = true
merging     = true
merge_bound = true
cfl_par     = 0.5
ppc         = 0.0        # creation mode: start with zero sinks

<problem>
cloud_radius   = 1.0
alpha          = 0.25
beta           = 0.20
amp            = 0.1
contrast       = 100.0
cs_iso         = 1.0     # cold-branch (isothermal) sound speed
rho1_fac       = 150.0   # rho1/rho0 : raised so the m=2 bar splits isothermally first
rho2_fac       = 3000.0  # rho2/rho0 : gamma=4/3 support below the finest sink threshold
gam1           = 1.1
gam2           = 1.3333333333333333
njeans         = 8
sink_buf_cells = 4
user_hist      = true
user_srcs      = true    # per-stage barotropic energy reset

<output1>
file_type = hst
dt        = 0.005

<output2>
file_type = bin
variable  = hydro_w
dt        = 0.02

<output3>
file_type = bin
variable  = prtcl_d
dt        = 0.02
