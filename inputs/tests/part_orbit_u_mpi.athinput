# AthenaK input: binary sink orbit, UNIFORM 64 MeshBlocks, for MPI-domain visualization.
# Two equal sinks (M=1, sep=0.3) on a circular orbit (period ~2.588) in inert near-vacuum
# gas, so grav_phi is produced entirely by the sink particle-mesh deposit. Root 64^3 split
# into 16^3 MeshBlocks = 64 blocks, so a 4-rank run gives 16 blocks/rank. Uniform (no AMR):
# this is the configuration where multi-rank sink gravity is bit-identical to serial, which
# makes it the valid one for an MPI-domain visualization. Outputs are written per-rank
# (single_file_per_rank) so the renderer can colour each MeshBlock by its owning rank.

<job>
basename = part_orbit_u

<mesh>
nghost = 2
nx1 = 64
x1min = -0.5
x1max =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -0.5
x2max =  0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -0.5
x3max =  0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
tlim       = 2.6
nlim       = -1
ndiag      = 50

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = llf
iso_sound_speed = 1.0

<gravity>
four_pi_G      = 1.0
mg_bc          = multipole
mporder        = 4
threshold      = -1
niteration     = 20
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
show_defect    = 0
mg_verbose     = 0
mg_nghost      = 1
root_on_host   = false

<hydro_srcterms>
self_gravity = false

<particles>
type   = sink
pusher = leapfrog
ppc    = 7.62939453125e-06

<problem>
mass       = 1.0
separation = 0.3
rho0       = 1.0e-8
vfrac      = 1.0
offx       = 0.0
offy       = 0.0
offz       = 0.0
diag_flush = true
refine_buf = 0.1

<output1>
file_type            = bin
variable             = grav_phi
dt                   = 0.02
single_file_per_rank = true

<output2>
file_type            = bin
variable             = prtcl_d
dt                   = 0.02
single_file_per_rank = true
