# AthenaK input: binary sink orbit with AMR (Phase: AMR validation)
# Two sinks orbit in self-gravitating gas; adaptive refinement is triggered by the GAS
# density enhancement the sinks produce (built-in min_max criterion on hydro_w_d), so the
# fine region tracks the sinks without a particle-based refinement function. Particles are
# re-binned each cycle so they survive AMR regrids. Periodic BC = the validated
# multigrid+AMR path.

<job>
basename = part_orbit_amr

<mesh>
nghost = 2
nx1 = 64
x1min = -0.5
x1max =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -0.5
x2max =  0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -0.5
x3max =  0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement       = adaptive
max_nmb_per_rank = 4096
num_levels       = 2

<amr_criterion0>
method = user

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
tlim       = 2.0
nlim       = -1
ndiag      = 50

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = llf
iso_sound_speed = 1.0

<gravity>
four_pi_G      = 1.0
mg_bc          = multipole
mporder        = 4
threshold      = -1
niteration     = 20
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
show_defect    = 0
mg_verbose     = 0
mg_nghost      = 1
root_on_host   = false

<hydro_srcterms>
self_gravity = false

<particles>
type   = sink
pusher = leapfrog
ppc    = 7.62939453125e-06

<problem>
mass       = 1.0
separation = 0.3
rho0       = 1.0e-8
vfrac      = 1.0
offx       = 0.0
offy       = 0.0
offz       = 0.0
diag_flush = false
refine_buf = 0.1

<output1>
file_type = bin
variable  = grav_phi
dt        = 0.04

<output2>
file_type  = trk
variable   = prtcl
nparticles = 2
dt         = 0.05
