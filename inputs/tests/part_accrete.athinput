# AthenaK input: sink control-volume accretion test (Phase 4a)
# One sink in uniform isothermal self-gravitating gas (periodic). Gas falls onto the
# sink and is accreted; total mass (gas + sink) should be conserved.
# Null test: run with hydro_srcterms/self_gravity=false -> static gas, no accretion.

<job>
basename = part_accrete

<mesh>
nghost = 4
nx1 = 64
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 64
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 64
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
tlim       = 0.1
nlim       = -1
ndiag      = 20

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = llf
iso_sound_speed = 1.0

<gravity>
four_pi_G      = 1.0
threshold      = -1
niteration     = 20
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
show_defect    = 0
mg_verbose     = 0
mg_nghost      = 1
root_on_host   = false

<hydro_srcterms>
self_gravity = true

<particles>
type      = sink
pusher    = leapfrog
accretion = true      # this test exercises control-volume accretion
# 1 / 64^3 = 2^-18 (exact) -> exactly 1 particle
ppc    = 3.814697265625e-06

<problem>
mass = 1.0
rho0 = 0.1
