# AthenaK: 3D hydro linear wave on a uniform (fixed) mesh — for GPU profiling on Della.
# Based on inputs/tests/linear_wave_hydro.athinput (Stone et al. 2008, sect. 8.1).
# No AMR/SMR: single MeshBlock, refinement=none.

<comment>
problem   = hydro linear waves, uniform 3D mesh
reference = Stone et al, ApJS 178, 137 (2008), sect 8.1

<job>
basename  = LinWaveUniform

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 3.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = 0.0
x2max     = 1.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 32
x3min     = 0.0
x3max     = 1.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 32
nx3       = 32

<mesh_refinement>
refinement = none

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 10
tlim       = 1.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
along_x1  = false
along_x2  = false
along_x3  = false

<output1>
file_type = tab
variable  = hydro_w
dt        = -1.0

<output2>
file_type = vtk
variable  = hydro_w
dt        = -1.0

<output3>
file_type = hst
dt        = -1.0
